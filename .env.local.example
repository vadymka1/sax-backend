APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000

DATABASE_URL=postgres://app:app_password@localhost:5432/app_db
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT_SECONDS=10

JWT_ACCESS_SECRET=replace_this_with_a_super_secret_access_key_min_32_bytes
JWT_REFRESH_SECRET=replace_this_with_a_super_secret_refresh_key_min_32_bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

PASSWORD_MIN_LENGTH=12

# CORS settings: Comma-separated list of allowed origins (Vite default: http://localhost:5173, Next default: http://localhost:3000)
# Wildcards are rejected to prevent security risks on private admin API endpoints.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:8000/uploads

MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100

RUST_LOG=info,spa_sax_backend=debug
RUST_BACKTRACE=1
